# KoriePay environment template.
#
# Copy this file to .env.local (git-ignored) and fill in real values for
# your environment. Nothing in this file is a real secret — every value
# below is a placeholder or a safe default. Do NOT commit .env.local.
#
# Variables are grouped by exposure. Anything prefixed NEXT_PUBLIC_ is
# bundled into client-side JavaScript and is visible to anyone who loads
# the app in a browser — never put a real secret behind that prefix.
# Everything else here is server-only and must never be exposed to the
# client bundle, logs, or error responses.

# -----------------------------------------------------------------------
# Supabase — public (safe to expose to the browser)
# -----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
# Newer Supabase projects issue a "publishable" key instead of/alongside
# the legacy anon key; set this too if your project uses the new format.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# -----------------------------------------------------------------------
# Supabase — server-only (NEVER expose these to the client bundle)
# -----------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# SECRET — bypasses Row Level Security entirely. Server-side only. Never
# log it, never send it in a response, never reuse it as a client key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
# SECRET — new-format equivalent of the service role key on some projects.
SUPABASE_SECRET_KEY=replace-with-your-secret-key
# SECRET — used to verify/sign Supabase Auth JWTs out of band. Rotating
# this invalidates every currently-issued session token.
SUPABASE_JWT_SECRET=replace-with-your-jwt-secret

# Direct Postgres connection string(s), used by scripts and CI (migration
# replay, the RLS perimeter guard in scripts/verify-rls.mjs, one-off admin
# scripts). SECRET — contains a database password.
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
# SECRET
POSTGRES_PASSWORD=postgres
# Alias some tooling/scripts look for instead of POSTGRES_URL — same value.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------
# Application secrets (server-only)
# -----------------------------------------------------------------------
# SECRET — shared bearer secret the deploy scheduler must present to call
# the cron endpoints (/api/cron/*). Generate with, e.g., `openssl rand -hex 32`.
CRON_SECRET=replace-with-a-long-random-value

# SECRET — 64-character hex string (32 bytes), used to symmetrically
# encrypt KYC identifier fields at rest. Generate with
# `openssl rand -hex 32`. Rotating this makes previously-encrypted values
# unreadable, so treat it like a database credential (back it up securely).
KYC_IDENTIFIER_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# SECRET — 64-character hex string (32 bytes), used to symmetrically
# encrypt stored merchant/aggregator webhook secrets. Deliberately a
# separate key from KYC_IDENTIFIER_ENCRYPTION_KEY so rotating one never
# affects the other. Generate with `openssl rand -hex 32`.
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# SECRET — used to verify inbound webhook signatures from the KoriePay
# payment processor.
KORIEPAY_WEBHOOK_SECRET=replace-with-your-webhook-secret
# SECRET — server-side API key used by example/demo integration snippets.
KORIEPAY_SECRET_KEY=replace-with-your-koriepay-secret-key

# -----------------------------------------------------------------------
# Public runtime config
# -----------------------------------------------------------------------
NODE_ENV=development

# Support contact details shown on the customer support page. Leave unset
# to hide the corresponding channel in the UI.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+2340000000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=+2340000000000

# Set to "live" to read real database-backed data in the compliance portal;
# any other value (including unset) serves bundled demo/sample fixtures.
NEXT_PUBLIC_COMPLIANCE_DATA_MODE=demo

# -----------------------------------------------------------------------
# Local tooling / scripts (not read by the deployed app itself)
# -----------------------------------------------------------------------
# Locale used by scripts/ux-shots.mjs when generating UI screenshots.
LOCALE=en
# Output directory for scripts/ux-shots.mjs and scripts/ux-sweep.mjs.
SHOTS=/tmp/koriepay-ux-shots
# Base URL scripts/seed-support-demo-data.mjs targets when seeding demo data.
SUPPORT_SEED_BASE_URL=http://localhost:3000
